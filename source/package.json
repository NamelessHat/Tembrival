{
  "name": "luma-music",
  "version": "0.21.1",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "package": "electron-builder --win dir"
  },
  "dependencies": {
    "music-metadata": "^11.9.0",
    "qrcode": "^1.5.4",
    "selfsigned": "3.0.1"
  },
  "devDependencies": {
    "electron": "39.8.10",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "local.luma.music",
    "productName": "Tembrival",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "ui/**/*",
      "package.json"
    ],
    "win": {
      "target": "dir",
      "icon": "desktop/icon.ico"
    },
    "asar": true,
    "extraResources": [
      {
        "from": "release/Tembrival-Android.apk",
        "to": "Tembrival-Android.apk"
      }
    ]
  },
  "description": "Local music library with offline Android Wi-Fi sync",
  "author": "NamelessHat",
  "androidVersionCode": 31,
  "releaseChannel": "public",
  "license": "SEE LICENSE IN LICENSE.md"
}
