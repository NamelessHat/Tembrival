<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:orientation="horizontal" android:padding="6dp" android:background="@drawable/notification_paper"><ImageView android:id="@+id/notice_art" android:layout_width="36dp" android:layout_height="36dp" android:contentDescription="Обложка трека"/><LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingLeft="8dp"><TextView android:id="@+id/notice_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#51334F" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/><TextView android:id="@+id/notice_artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#805169" android:textSize="11sp" android:maxLines="1" android:ellipsize="end"/></LinearLayout><ImageButton android:id="@+id/notice_prev" android:layout_width="36dp" android:layout_height="36dp" android:layout_marginLeft="5dp" android:padding="8dp" android:src="@drawable/ic_prev_pixel" android:background="@drawable/notification_button" android:contentDescription="Предыдущий трек" android:scaleType="fitCenter"/><ImageButton android:id="@+id/notice_play" android:layout_width="40dp" android:layout_height="36dp" android:layout_marginLeft="5dp" android:padding="8dp" android:src="@drawable/ic_play_pixel" android:background="@drawable/notification_play" android:contentDescription="Играть или пауза" android:scaleType="fitCenter"/><ImageButton android:id="@+id/notice_next" android:layout_width="36dp" android:layout_height="36dp" android:layout_marginLeft="5dp" android:padding="8dp" android:src="@drawable/ic_next_pixel" android:background="@drawable/notification_button" android:contentDescription="Следующий трек" android:scaleType="fitCenter"/></LinearLayout>